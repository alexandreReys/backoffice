generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  password      String
  socialId      String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  permissions   Json      @default("[]")
  photoUrl      String?
  emailVerified DateTime?

  branchUsers BranchUser[] @relation("UserBranches")

  @@map("users")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches Branch[] @relation("CompanyBranches")

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation("CompanyBranches", fields: [companyId], references: [id])
  branchUsers BranchUser[] @relation("BranchUsers")
  branchBots  Bot[]        @relation("BranchBots")
  branchTasks Task[]       @relation("BranchTasks")

  @@index([companyId, id])
  @@map("branches")
}

model BranchUser {
  id        String   @id @default(uuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())

  user   User   @relation("UserBranches", fields: [userId], references: [id])
  branch Branch @relation("BranchUsers", fields: [branchId], references: [id])

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
  @@map("branch_users")
}

model Bot {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation("BranchBots", fields: [branchId], references: [id])

  @@index([branchId, id])
  @@map("bots")
}

model Task {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation("BranchTasks", fields: [branchId], references: [id])

  @@index([branchId, id])
  @@map("tasks")
}
